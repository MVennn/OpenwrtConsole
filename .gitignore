# ---------------------------------------------------------------------------
# 依赖与构建产物
# ---------------------------------------------------------------------------

# 依赖目录。装一次几百 MB，不入库。
node_modules/

# 构建产物。**每次构建的文件名 hash 都会变**（index-<hash>.js / index-<hash>.css），
# 入库只会让仓库无限膨胀，而且永远对不上任何一个已部署的版本。
# 需要复现某次产物请用 `npm run build` 重新构建。
dist/

# 本地预览/临时产物目录
.vite/
.cache/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# 环境与本地配置
# ---------------------------------------------------------------------------

# 本地环境变量。**可能包含路由器口令**，绝不入库。
.env
.env.*
!.env.example

# 各种「本地私有」配置
*.local
*.local.json
*.local.yaml
*.local.yml

# ---------------------------------------------------------------------------
# 日志与临时文件
# ---------------------------------------------------------------------------

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

logs/
*.pid
*.seed
*.pid.lock

# 备份与转储
*.bak
*.orig
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 编辑器 / IDE
# ---------------------------------------------------------------------------

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------------------------------
# 本机部署与抓包产生的敏感文件
# ---------------------------------------------------------------------------

# SSH 免密与 askpass 脚本（部署用，含凭据）
askpass.sh
*.ppk
id_rsa
id_rsa.*
id_ed25519

# 路由器上抓下来的运行时快照（可能含会话 sid）
router-*.json
*.har

# ---------------------------------------------------------------------------
# 注意：源码与文档一律**不**排除
# ---------------------------------------------------------------------------
# src/、deploy/、docs/、public/、README.md、DEPLOY.md、DESIGN.md、CHANGELOG.md、
# NOTICE、AGENTS.md、package.json、package-lock.json、vite.config.ts、
# tsconfig.json、index.html 全部入库。
# package-lock.json 是依赖锁文件，**必须**入库 —— 否则同一份 package.json
# 在不同机器上装出不同依赖，构建不可复现。

# ---------------------------------------------------------------------------
# third-party/ —— 上游开源项目的原样 vendor
# ---------------------------------------------------------------------------
# 这里的文件必须**逐字节**保留上游内容，一个字节都不能本地化。
# 上游 art-design-pro 自带 .env / .env.development / .env.production（模板值，
# 无凭据）与 .vscode/ 等文件；若被上面的 `.env` / `.env.*` / `.vscode/*` 通配
# 连带排除，等于悄悄改了上游内容 —— 所以整棵 third-party/ 一律放行。
# 放行之后再把不该入库的依赖目录挡回去（vendor 目录里不装 node_modules）。
!third-party/**
third-party/**/node_modules/
third-party/**/dist/

# ---- 脱敏未完成前的临时拦截（见 PRIVACY-INVENTORY.md）----

# CodeGraph 索引（本机生成，不入库）
/.codegraph/
