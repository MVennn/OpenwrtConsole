#!/bin/sh
# POST /cgi-bin/modern-pkg?sid=<session>
# Body: { "action": "<action>", "params": { ... } }
#
# Software package management for the modern console. This router manages its
# packages with apk (apk-tools 3.x), so this CGI is the only place that knows
# how the package database looks.
#
# Read actions return the package list as a JSON array:
#   list       installed packages (name/version/description/size)
#   available  packages offered by the configured repositories
#   search     the same lists filtered by a keyword
#   stats      counters only (installed/installable/upgradable/index time)
#
# The repository holds more than ten thousand entries, so "available" and
# "search" take an optional offset and limit and answer with one page. Every
# answer still carries the real number of matches (matchedCount), so the
# console can page through the whole repository instead of a hard cut.
#
# Every package of a list carries two extra fields:
#   "installed"    true when the package is already on the router
#   "dependencies" number of packages the repository entry depends on
#
# Write actions never run inside the request. They start a background job that
# the console polls with the "status" action, because `apk upgrade` may run for
# minutes while uhttpd would otherwise drop the connection:
#   install / remove / update / upgrade
#
# Safety rules enforced here:
#   * the session is validated against rpcd before anything is executed
#   * package names must match [A-Za-z0-9._+-]{1,64} and may not start with a
#     dash, so a name can never be read as an option by apk
#   * write actions require confirm=yes, so a stray POST cannot change the box
#   * every command runs under a watchdog that kills it with SIGKILL
#   * outputs are truncated and the number of returned packages is capped

MAX_BODY=8192
MAX_OUTPUT=204800
MAX_INSTALLED=600
MAX_AVAILABLE=400

JOB_ROOT="/tmp/modern-pkg-jobs"
STATE_DIR="/tmp/modern-pkg"
WORK="$STATE_DIR/work.$$"

T_READ=30
T_INSTALL=300
T_REMOVE=180
T_UPDATE=300
T_UPGRADE=900

APK_FIELDS="name,version,description,installed-size,file-size,arch,license,origin"
# The repository holds more than ten thousand packages. The available list
# only needs the fields the table shows, and every field makes the JSON
# that has to be parsed on the router bigger. The "depends" field carries the
# dependencies of the entry, which the console shows before an install.
APK_FIELDS_AVAIL="name,version,description,installed-size,depends"

CACHE_DIR="/tmp/modern-pkg-cache"
# The repository index and the parsed pool are a cache, not state: they can be
# rebuilt from the network. /tmp is a 48 MB tmpfs on this class of router, so
# keeping 4.4 MB of cache there costs RAM the proxy core needs. The overlay
# keeps the cache across reboots and frees that RAM; it is preferred when it
# has room. A box without a usable overlay falls back to /tmp.
CACHE_OVERLAY="/overlay/modern-pkg-cache"
CACHE_MIN_FREE_KB=16384
APK_CACHE_DIR="$CACHE_DIR/apk"

pick_cache_dir() {
	[ -d /overlay ] || return 0

	if [ -d "$CACHE_OVERLAY" ]; then
		[ -w "$CACHE_OVERLAY" ] || return 0
	else
		_free="$(df -k /overlay 2>/dev/null | awk 'NR == 2 { print $4 }')"
		case "$_free" in ''|*[!0-9]*) return 0 ;; esac
		[ "$_free" -ge "$CACHE_MIN_FREE_KB" ] || return 0
		mkdir -p "$CACHE_OVERLAY" 2>/dev/null || return 0
	fi

	# Move the cache built by the /tmp era once. It is only a cache, so a
	# failed copy is harmless: the next query rebuilds it. -p keeps the index
	# mtimes, which are part of the pool key: without it the first query
	# after the move would rebuild the pool for no reason.
	if [ -d "$CACHE_DIR" ] && [ "$CACHE_DIR" != "$CACHE_OVERLAY" ]; then
		cp -pR "$CACHE_DIR"/. "$CACHE_OVERLAY"/ 2>/dev/null
		rm -rf "$CACHE_DIR" 2>/dev/null
	fi

	CACHE_DIR="$CACHE_OVERLAY"
	APK_CACHE_DIR="$CACHE_DIR/apk"
}
# The runtime configuration of ShellCrash carries the port its mixed proxy
# really listens on.
RUNTIME_CONFIG="/tmp/ShellCrash/config.yaml"

# The mixed port of ShellCrash; 7890 is its default.
shellcrash_mixed_port() {
	_p="$(sed -n 's/^[[:space:]]*mixed-port:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$RUNTIME_CONFIG" 2>/dev/null | head -n 1)"
	case "$_p" in
		''|*[!0-9]*) _p=7890 ;;
	esac
	printf '%s' "$_p"
}

# 准备 apk 缓存目录；ShellCrash 混合端口在时让 apk 走代理出网。
#
# netstat prints an IPv6 listener as ":::7890" and an IPv4 one as
# "127.0.0.1:7890", so the check matches the port itself instead of a fixed
# address.
apk_env() {
	mkdir -p "$APK_CACHE_DIR" 2>/dev/null
	_mp="$(shellcrash_mixed_port)"
	if netstat -lnt 2>/dev/null | grep -q ":$_mp[[:space:]]"; then
		APK_PROXY="http://127.0.0.1:$_mp"
		http_proxy="$APK_PROXY"
		https_proxy="$APK_PROXY"
		export http_proxy https_proxy
	fi
}

deny() {
	printf 'Status: 401 Unauthorized\r\n'
	printf 'Content-Type: application/json; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n\r\n'
	printf '{"error":"unauthorized"}'
	exit 0
}

# Sends the body of a reply. The body is validated before it leaves the
# router: a malformed answer only shows up in the browser as "cannot parse"
# and hides the real cause, so a body that does not survive jsonfilter is
# replaced by a readable error.
send_json() {
	__sj_body="$1"
	__sj_out="/tmp/.modern-resp.$$"
	printf '%s' "$__sj_body" > "$__sj_out" 2>/dev/null
	if command -v jsonfilter >/dev/null 2>&1; then
		if ! jsonfilter -i "$__sj_out" -e '@' >/dev/null 2>&1; then
			printf '%s' '{"ok":false,"error":"路由器生成了无效的响应，请查看系统日志"}' > "$__sj_out"
		fi
	fi
	cat "$__sj_out"
	rm -f "$__sj_out" 2>/dev/null
}

fail() {
	printf 'Status: %s\r\n' "$1"
	printf 'Content-Type: application/json; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n\r\n'
	send_json "$2"
	exit 0
}

ok() {
	printf 'Status: 200 OK\r\n'
	printf 'Content-Type: application/json; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n\r\n'
	send_json "$1"
	exit 0
}

cleanup() {
	rm -rf "$WORK" 2>/dev/null
}

# ---------------------------------------------------------------- session ---
# The sid may arrive in the owrt_sid cookie or as ?sid=; both are validated
# against rpcd before anything is executed.

qs="${QUERY_STRING:-}"
sid=""
oldIFS=$IFS
IFS='&'
for pair in $qs; do
	key="${pair%%=*}"
	val="${pair#*=}"
	case "$key" in
		sid) sid="$val" ;;
	esac
done
IFS=$oldIFS

if [ -z "$sid" ]; then
	sid="$(printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed -n 's/^ *owrt_sid=//p' | head -n 1)"
fi
[ -n "$sid" ] || deny

# Only characters that are inert inside the ubus JSON payload are accepted,
# so a session id can never break out of the string it is placed in.
case "$sid" in
	*[!A-Za-z0-9._~+/=-]*) deny ;;
esac

ubus call session get "{\"ubus_rpc_session\":\"$sid\"}" 2>/dev/null | grep -q '"username"' || deny

# Cache selection runs after authentication: an unauthenticated request must
# not create or move directories.
pick_cache_dir

# ------------------------------------------------------------------ body ---
[ "${REQUEST_METHOD:-GET}" = "POST" ] ||
	fail "405 Method Not Allowed" '{"error":"只接受 POST 请求"}'

body="$(head -c $((MAX_BODY + 1)) 2>/dev/null)"
[ -n "$body" ] || fail "400 Bad Request" '{"error":"请求体为空"}'
[ "${#body}" -le "$MAX_BODY" ] || fail "413 Payload Too Large" '{"error":"请求体过大"}'

# One flat line keeps the key/value extraction below predictable.
body="$(printf '%s' "$body" | tr '\012\015\011' '   ')"

json_string() {
	# $1 = key name. Prints the value of the first "key":"value" pair found.
	# The value can never contain a quote, so it stays a single token.
	printf '%s' "$body" |
		grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" |
		head -n 1 |
		sed 's/^"[^"]*"[[:space:]]*:[[:space:]]*"\(.*\)"$/\1/'
}

action="$(json_string action)"
pkg_name="$(json_string name)"
keyword="$(json_string keyword)"
scope="$(json_string scope)"
limit_raw="$(json_string limit)"
offset_raw="$(json_string offset)"
confirm="$(json_string confirm)"
job_id="$(json_string job)"

[ -n "$action" ] || fail "400 Bad Request" '{"error":"缺少操作名称"}'

# The console speaks apk only. A firmware that still uses opkg gets a clear
# answer for every action instead of an empty list or an "unsupported action"
# that hides the real cause; a box with neither tool gets its own error.
if ! command -v apk >/dev/null 2>&1; then
	if command -v opkg >/dev/null 2>&1; then
		fail "501 Not Implemented" '{"ok":false,"error":"此固件使用 opkg，控制台目前只支持 apk（OpenWrt 24.10+）","code":"opkg_not_supported"}'
	fi
	fail "501 Not Implemented" '{"ok":false,"error":"当前固件没有 apk 或 opkg，无法管理软件包","code":"package_manager_missing"}'
fi

mkdir -p "$STATE_DIR" "$JOB_ROOT" 2>/dev/null
cleanup
trap cleanup EXIT INT TERM

# A request killed before its EXIT trap leaves work.<pid> behind. Only
# directories whose PID is gone are removed, so a concurrent request can never
# lose its work dir.
for _stale in "$STATE_DIR"/work.*; do
	[ -d "$_stale" ] || continue
	_pid="${_stale##*.}"
	case "$_pid" in ''|*[!0-9]*) continue ;; esac
	[ -d "/proc/$_pid" ] && continue
	rm -rf "$_stale" 2>/dev/null
done

mkdir -p "$WORK" 2>/dev/null || fail "500 Internal Server Error" '{"error":"无法创建临时目录"}'

# --------------------------------------------------------------- helpers ---
# Runs a command with a watchdog. The router has no coreutils timeout, so the
# command is started in its own session and killed with SIGKILL when it
# overruns. stdout goes to $2, stderr to $2.err.
run_bg() {
	_rt="$1"
	_rf="$2"
	shift 2
	: > "$_rf" 2>/dev/null
	: > "$_rf.err" 2>/dev/null
	_rg=0
	if command -v setsid >/dev/null 2>&1; then
		setsid "$@" > "$_rf" 2>"$_rf.err" </dev/null &
		_rg=1
	else
		"$@" > "$_rf" 2>"$_rf.err" </dev/null &
	fi
	_rp=$!
	# The watchdog counts the seconds itself instead of running one long
	# sleep, so that stopping it cannot leave a stray sleep behind on a
	# router with little memory.
	(
		_i=0
		while [ "$_i" -lt "$_rt" ]; do
			sleep 1
			_i=$((_i + 1))
		done
		if [ "$_rg" = 1 ]; then kill -9 -"$_rp" 2>/dev/null; else kill -9 "$_rp" 2>/dev/null; fi
	) &
	_rgd=$!
	wait "$_rp" 2>/dev/null
	_rs=$?
	kill "$_rgd" 2>/dev/null
	wait "$_rgd" 2>/dev/null
	return $_rs
}

# Escapes a file (or stdin) into a JSON string body, without the quotes. The
# backslash is built with sprintf because BusyBox awk and gawk disagree about
# backslashes written literally in a gsub replacement.
esc_json() {
	awk '
	BEGIN { BS = sprintf("%c", 92); Q = sprintf("%c", 34) }
	NR > 1 { printf "\\n" }
	{
		s = $0
		gsub(/\\/, BS BS BS BS, s)
		gsub(/"/, BS BS Q, s)
		gsub(/\t/, BS BS "t", s)
		gsub(/\r/, BS BS "r", s)
		gsub(/[\001-\037]/, " ", s)
		printf "%s", s
	}'
}

# awk program that turns the JSON array produced by `apk query --format json`
# into one object per line (JSON lines). The objects are passed through
# unchanged except for the two renamed size fields, and every line starts with
# the "installed" flag:
#
#   {"installed":false,"name":"curl","version":"...","description":"...",...}
#
# The repository has more than ten thousand entries and one pass over it costs
# seconds on the router, so the result is cached as a single file: paging and
# the keyword search are then `wc -l`, `grep` and a line slice instead of
# another parse. No value is re-escaped here - the apk output is already JSON.
#
#   -v installed  file with the names of the installed packages
PARSE_PROG='
BEGIN {
	if (installed != "") {
		while ((getline line < installed) > 0) {
			if (line != "") inst[line] = 1
		}
		close(installed)
	}
	started = 0
}
{
	line = $0
	if (!started) {
		if (line == "[") started = 1
		next
	}
	if (line == "]") next
	head = substr(line, 1, 3)
	if (head == "  {") { body = ""; nm = ""; n = 0; next }
	if (head == "  }") {
		if (nm != "") emit(nm, body)
		# The line "  }, {" closes one object and opens the next one, so the
		# state has to be cleared here as well.
		body = ""; nm = ""; n = 0
		next
	}
	if (n == 0) nm = name_of(line)
	n++
	ln = line
	sub(/^[ \t]+/, "", ln)
	body = (body == "") ? ln : body " " ln
}
function emit(nm, b,   inst_flag) {
	inst_flag = (nm in inst) ? "true" : "false"
	gsub(/"installed-size"[[:space:]]*:/, "\"installedSize\":", b)
	gsub(/"file-size"[[:space:]]*:/, "\"fileSize\":", b)
	printf "{\"installed\":%s,%s}\n", inst_flag, b
}
# The name is the first field of every object. Plain string handling is used
# on purpose: a regular expression would be evaluated for each of the more
# than ten thousand packages in the repository, which costs seconds on the
# busybox awk of the router.
function name_of(ln,   p, rest, q, r) {
	p = index(ln, "\"name\"")
	if (p == 0) return ""
	rest = substr(ln, p + 6)
	q = index(rest, "\"")
	if (q == 0) return ""
	rest = substr(rest, q + 1)
	r = index(rest, "\"")
	if (r == 0) return ""
	return substr(rest, 1, r - 1)
}
'

# Builds the JSON lines file. $1 apk JSON, $2 target file, $3 installed names.
build_pool() {
	awk -v installed="$3" "$PARSE_PROG" "$1" > "$2" 2>/dev/null
}

# Copies one page out of the JSON lines file. $1 source, $2 offset,
# $3 limit, $4 target (a JSON array).
render_page() {
	awk -v off="$2" -v lim="$3" '
	BEGIN { first = 1; printf "[" }
	{
		if (NR > off && n < lim) {
			if (first) printf "\n"
			else printf ",\n"
			first = 0
			printf "%s", $0
			n++
		}
	}
	END { if (!first) printf "\n"; printf "]" }
	' "$1" > "$4" 2>/dev/null
}

# Prints the epoch of the newest repository index, or 0 when it is missing.
# Only the cache directory this CGI passes to apk counts: /var/cache/apk holds
# indexes written by other tools, and reporting one of those as the index
# would claim a repository that the queries below never read.
index_updated_at() {
	_c="$(ls -t "$APK_CACHE_DIR"/APKINDEX.* 2>/dev/null | head -n 1)"
	[ -n "$_c" ] || { printf '0'; return; }
	date -r "$_c" +%s 2>/dev/null || printf '0'
}

# Writes the installed package names, one per line, into $2.
installed_names() {
	awk '
	{
		if (match($0, /"name"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
			s = substr($0, RSTART, RLENGTH)
			p = index(s, ":")
			s = substr(s, p + 1)
			q = index(s, "\"")
			s = substr(s, q + 1)
			sub(/"$/, "", s)
			if (s != "") print s
		}
	}' "$1" > "$2"
}

# The warnings apk prints on stderr are worth showing: they tell the user that
# the repository index is missing or unreachable.
stderr_note() {
	[ -f "$1" ] || return 0
	head -c 4000 "$1" 2>/dev/null | tr -d '\r' | sed '/^$/d'
}

# Normalises the keyword: control characters are dropped and the length is
# capped. The keyword is only ever used for matching inside awk and for the
# summary text, never as an argument of a command.
safe_keyword() {
	printf '%s' "$1" | tr -d '\000-\037\177' | cut -c1-64
}

# ------------------------------------------------------------- read paths ---

# Fills $WORK/installed.json with the installed packages.
load_installed() {
	run_bg "$T_READ" "$WORK/installed.json" \
		apk query --installed --format json --fields "$APK_FIELDS" "*"
}

# Fills $WORK/available.json with the packages offered by the repositories.
load_available() {
	apk_env
	run_bg "$T_READ" "$WORK/available.json" \
		apk --cache-dir "$APK_CACHE_DIR" query --available --format json --fields "$APK_FIELDS_AVAIL" "*"
}

# The parsed repository is cached, because building it needs a full pass over
# the index. The key contains the age of the index and a checksum of the
# installed package names, so the cache is dropped as soon as the router
# installs or removes something.
cache_key() {
	_k="$(printf '%s' "$1" | md5sum | cut -c1-12)"
	printf '%s-%s' "$_k" "$(md5sum "$2" 2>/dev/null | cut -c1-12)"
}

# True when the JSON lines file of a key exists.
pool_get() {
	[ -f "$CACHE_DIR/$1.pool" ]
}

# Stores the JSON lines file of a key and drops every other one: a pool is a
# few megabytes, and only the state of the current index is worth keeping.
pool_put() {
	mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
	cp "$2" "$CACHE_DIR/$1.pool.tmp" 2>/dev/null &&
		mv "$CACHE_DIR/$1.pool.tmp" "$CACHE_DIR/$1.pool" 2>/dev/null
	for _f in "$CACHE_DIR"/*.pool; do
		[ -f "$_f" ] || continue
		[ "$_f" = "$CACHE_DIR/$1.pool" ] && continue
		rm -f "$_f" 2>/dev/null
	done
	# The previous format cached one page per keyword and limit; those files are
	# dead now and would only keep the memory of the tmpfs.
	rm -f "$CACHE_DIR"/*.json "$CACHE_DIR"/*.count "$CACHE_DIR"/*.free 2>/dev/null
	return 0
}

# Prints the path of the JSON lines file for the current index and installed
# packages, building it when it is missing.
ensure_pool() {
	_p_it="$(index_updated_at)"
	_p_key="$(cache_key "$_p_it" "$1")"
	if pool_get "$_p_key"; then
		printf '%s' "$CACHE_DIR/$_p_key.pool"
		return 0
	fi
	load_available
	_p_rc=$?
	# 查询失败（断网/代理不通/超时）时 available.json 为空或不是 JSON 数组。
	# 这种结果绝不能进缓存，否则页面会一直命中"可安装 0 个"直到索引更新。
	if [ "$_p_rc" -ne 0 ] || [ ! -s "$WORK/available.json" ] ||
		[ "$(head -c 1 "$WORK/available.json" 2>/dev/null)" != "[" ]; then
		printf '%s\n' "apk query failed: $(head -c 200 "$WORK/available.json.err" 2>/dev/null)" >&2
		build_pool "$WORK/available.json" "$WORK/pool.ndjson" "$1"
		printf '%s' "$WORK/pool.ndjson"
		return 0
	fi
	build_pool "$WORK/available.json" "$WORK/pool.ndjson" "$1"
	pool_put "$_p_key" "$WORK/pool.ndjson"
	if pool_get "$_p_key"; then
		printf '%s' "$CACHE_DIR/$_p_key.pool"
	else
		printf '%s' "$WORK/pool.ndjson"
	fi
}

# Counts the packages that a newer version exists for. The index cache has to
# be the one the other queries use: the default cache of the firmware is a
# different directory and is empty after a reboot, which silently turns every
# package into "up to date".
upgradable_count() {
	apk_env
	run_bg "$T_READ" "$WORK/upgradable.json" \
		apk --cache-dir "$APK_CACHE_DIR" query --upgradable --format json --fields name,version "*"
	_n="$(grep -c '"name"' "$WORK/upgradable.json" 2>/dev/null)"
	case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
	printf '%s' "$_n"
}

# The packages that a newer version exists for, with the new version. The
# JSON of apk is passed through unchanged, so the console can read it as it
# is. An answer that is not an array becomes an empty one.
upgradable_list() {
	_ug="$(head -c 200000 "$WORK/upgradable.json" 2>/dev/null | tr -d '\r')"
	case "$_ug" in
		'['*) ;;
		*) _ug="[]" ;;
	esac
	printf '%s' "$_ug"
}

# $1 = keyword. The installed packages, optionally filtered. The whole list is
# small, so it is parsed on every request and never cached.
action_installed() {
	_kw="$(safe_keyword "$1")"

	load_installed
	installed_names "$WORK/installed.json" "$WORK/installed.names"
	build_pool "$WORK/installed.json" "$WORK/installed.ndjson" "$WORK/installed.names"

	if [ -n "$_kw" ]; then
		grep -iF -e "$_kw" "$WORK/installed.ndjson" > "$WORK/matched.ndjson" 2>/dev/null
		_src="$WORK/matched.ndjson"
	else
		_src="$WORK/installed.ndjson"
	fi

	_cnt="$(wc -l < "$_src" 2>/dev/null)"
	case "$_cnt" in ''|*[!0-9]*) _cnt=0 ;; esac

	render_page "$_src" 0 "$MAX_INSTALLED" "$WORK/packages.json"

	_uc="$(upgradable_count)"
	_ug="$(upgradable_list)"
	_it="$(index_updated_at)"

	_out="已安装 $_cnt 个软件包"
	[ -n "$_kw" ] && _out="匹配「$_kw」的软件包 $_cnt 个"
	_note="$(stderr_note "$WORK/installed.json.err")"
	[ -n "$_note" ] && _out="$_out
$_note"

	ok "{\"ok\":true,\"output\":\"$(printf '%s' "$_out" | esc_json)\",\"packages\":$(cat "$WORK/packages.json"),\"installedCount\":$_cnt,\"upgradableCount\":$_uc,\"upgradable\":$_ug,\"indexUpdatedAt\":$_it}"
}

# $1 = keyword. The packages offered by the repositories. The packages that
# are already installed are part of the list and are marked as such, so the
# console can tell the user that there is nothing to install.
#
# The whole repository is one cached file; offset and limit only select the
# slice that is sent back. matchedCount is the real number of matches, so the
# console can page through every entry instead of a hard cut.
action_available() {
	_kw="$(safe_keyword "$1")"

	_lim="$MAX_AVAILABLE"
	case "$limit_raw" in
		''|*[!0-9]*) ;;
		*) [ "$limit_raw" -gt 0 ] && _lim="$limit_raw" ;;
	esac
	[ "$_lim" -le "$MAX_AVAILABLE" ] || _lim="$MAX_AVAILABLE"

	_off=0
	case "$offset_raw" in
		''|*[!0-9]*) ;;
		*) _off="$offset_raw" ;;
	esac

	load_installed
	installed_names "$WORK/installed.json" "$WORK/installed.names"
	_ic="$(wc -l < "$WORK/installed.names" 2>/dev/null)"
	case "$_ic" in ''|*[!0-9]*) _ic=0 ;; esac

	_it="$(index_updated_at)"
	_pool="$(ensure_pool "$WORK/installed.names")"

	if [ -n "$_kw" ]; then
		grep -iF -e "$_kw" "$_pool" > "$WORK/matched.ndjson" 2>/dev/null
		_src="$WORK/matched.ndjson"
	else
		_src="$_pool"
	fi

	_cnt="$(wc -l < "$_src" 2>/dev/null)"
	case "$_cnt" in ''|*[!0-9]*) _cnt=0 ;; esac
	_free="$(grep -c '"installed":false' "$_src" 2>/dev/null)"
	case "$_free" in ''|*[!0-9]*) _free=0 ;; esac

	render_page "$_src" "$_off" "$_lim" "$WORK/packages.json"

	_out="仓库中可安装 $_free 个软件包"
	[ -n "$_kw" ] && _out="仓库中匹配「$_kw」的软件包 $_cnt 个（可安装 $_free 个）"
	_note="$(stderr_note "$WORK/available.json.err")"
	[ -n "$_note" ] && _out="$_out
$_note"

	ok "{\"ok\":true,\"output\":\"$(printf '%s' "$_out" | esc_json)\",\"packages\":$(cat "$WORK/packages.json"),\"availableCount\":$_free,\"matchedCount\":$_cnt,\"installedCount\":$_ic,\"indexUpdatedAt\":$_it,\"offset\":$_off,\"limit\":$_lim}"
}

# The counters of the page. They are read from the cached repository file, so
# opening the page does not parse the index again.
action_stats() {
	load_installed
	installed_names "$WORK/installed.json" "$WORK/installed.names"
	_ic="$(wc -l < "$WORK/installed.names" 2>/dev/null)"
	case "$_ic" in ''|*[!0-9]*) _ic=0 ;; esac

	_it="$(index_updated_at)"
	_pool="$(ensure_pool "$WORK/installed.names")"

	_cnt="$(wc -l < "$_pool" 2>/dev/null)"
	case "$_cnt" in ''|*[!0-9]*) _cnt=0 ;; esac
	_free="$(grep -c '"installed":false' "$_pool" 2>/dev/null)"
	case "$_free" in ''|*[!0-9]*) _free=0 ;; esac

	_uc="$(upgradable_count)"

	ok "{\"ok\":true,\"installedCount\":$_ic,\"availableCount\":$_free,\"matchedCount\":$_cnt,\"upgradableCount\":$_uc,\"indexUpdatedAt\":$_it}"
}

# ------------------------------------------------------------------ jobs ---
cleanup_jobs() {
	_now="$(date +%s 2>/dev/null)"
	case "$_now" in ''|*[!0-9]*) return 0 ;; esac
	for _d in "$JOB_ROOT"/*; do
		[ -d "$_d" ] || continue
		_b="${_d##*/}"
		_e="${_b%%-*}"
		case "$_e" in ''|*[!0-9]*) continue ;; esac
		[ $((_now - _e)) -gt 3600 ] && rm -rf "$_d" 2>/dev/null
	done
	return 0
}

# Starts a background job. $1 = timeout, rest = command.
start_job() {
	_to="$1"
	shift
	_id="$(date +%s 2>/dev/null)-$(head -c 32 /dev/urandom 2>/dev/null | md5sum | cut -c1-12)"
	[ -n "$_id" ] || return 1
	_dir="$JOB_ROOT/$_id"
	mkdir -p "$_dir" 2>/dev/null || return 1

	cat > "$_dir/worker.sh" <<'WORKER'
#!/bin/sh
# Runs one command under a watchdog.
#   $1 timeout seconds, $2 output file, $3 status file, $4 exit file, $5.. command
timeout="$1"
out="$2"
statusf="$3"
exitf="$4"
shift 4

: > "$out" 2>/dev/null
echo running > "$statusf" 2>/dev/null

grp=0
if command -v setsid >/dev/null 2>&1; then
	setsid "$@" > "$out" 2>&1 </dev/null &
	grp=1
else
	"$@" > "$out" 2>&1 </dev/null &
fi
pid=$!

( i=0; while [ "$i" -lt "$timeout" ]; do sleep 1; i=$((i + 1)); done; echo timeout > "$statusf.timeout" 2>/dev/null; if [ "$grp" = 1 ]; then kill -9 -"$pid" 2>/dev/null; else kill -9 "$pid" 2>/dev/null; fi ) &
guard=$!

wait "$pid" 2>/dev/null
code=$?
kill "$guard" 2>/dev/null
wait "$guard" 2>/dev/null

if [ -f "$statusf.timeout" ]; then
	echo 124 > "$exitf"
	echo timeout > "$statusf"
else
	echo "$code" > "$exitf"
	echo done > "$statusf"
fi
WORKER
	chmod +x "$_dir/worker.sh" 2>/dev/null

	setsid "$_dir/worker.sh" "$_to" "$_dir/out" "$_dir/status" "$_dir/exit" \
		"$@" >/dev/null 2>&1 </dev/null &
	printf '%s' "$_id"
}

action_status() {
	case "$job_id" in
		''|*[!A-Za-z0-9-]*) fail "400 Bad Request" '{"error":"任务编号无效"}' ;;
	esac
	_dir="$JOB_ROOT/$job_id"
	[ -d "$_dir" ] || fail "404 Not Found" '{"error":"任务不存在或已过期"}'

	_state="$(cat "$_dir/status" 2>/dev/null)"
	[ -n "$_state" ] || _state="running"
	_code="$(cat "$_dir/exit" 2>/dev/null)"
	case "$_code" in ''|*[!0-9]*) _code=0 ;; esac

	_out="$(head -c "$MAX_OUTPUT" "$_dir/out" 2>/dev/null | esc_json)"

	ok "{\"ok\":true,\"job_id\":\"$job_id\",\"status\":\"$_state\",\"exit_code\":$_code,\"output\":\"$_out\"}"
}

# ----------------------------------------------------------- write paths ----

valid_package_name() {
	case "$1" in
		'') return 1 ;;
		-*) return 1 ;;
		*[!A-Za-z0-9._+-]*) return 1 ;;
	esac
	[ "${#1}" -le 64 ] || return 1
	return 0
}

require_confirm() {
	[ "$confirm" = "yes" ] || fail "403 Forbidden" '{"error":"操作需要确认"}'
}

action_install() {
	require_confirm
	valid_package_name "$pkg_name" || fail "400 Bad Request" '{"error":"软件包名称不合法"}'
	cleanup_jobs
	# install 也要联网下载，必须和 update/upgrade 一样走代理并复用索引缓存。
	apk_env
	_id="$(start_job "$T_INSTALL" apk --cache-dir "$APK_CACHE_DIR" add --no-interactive --no-cache-packages "$pkg_name")"
	[ -n "$_id" ] || fail "500 Internal Server Error" '{"error":"无法启动任务"}'
	ok "{\"ok\":true,\"job_id\":\"$_id\",\"status\":\"running\",\"output\":\"正在安装 $pkg_name\",\"packages\":[]}"
}

action_remove() {
	require_confirm
	valid_package_name "$pkg_name" || fail "400 Bad Request" '{"error":"软件包名称不合法"}'
	cleanup_jobs
	_id="$(start_job "$T_REMOVE" apk del --no-interactive "$pkg_name")"
	[ -n "$_id" ] || fail "500 Internal Server Error" '{"error":"无法启动任务"}'
	ok "{\"ok\":true,\"job_id\":\"$_id\",\"status\":\"running\",\"output\":\"正在卸载 $pkg_name\",\"packages\":[]}"
}

action_update() {
	require_confirm
	cleanup_jobs
	apk_env
	_id="$(start_job "$T_UPDATE" apk --cache-dir "$APK_CACHE_DIR" update)"
	[ -n "$_id" ] || fail "500 Internal Server Error" '{"error":"无法启动任务"}'
	ok "{\"ok\":true,\"job_id\":\"$_id\",\"status\":\"running\",\"output\":\"正在更新仓库索引\",\"packages\":[]}"
}

# Upgrades one package or, without a name, every package.
action_upgrade() {
	require_confirm
	cleanup_jobs
	apk_env
	if [ -n "$pkg_name" ]; then
		valid_package_name "$pkg_name" || fail "400 Bad Request" '{"error":"软件包名称不合法"}'
		_id="$(start_job "$T_UPGRADE" apk --cache-dir "$APK_CACHE_DIR" upgrade --no-interactive --no-cache-packages "$pkg_name")"
		_note="正在升级 $pkg_name"
	else
		_id="$(start_job "$T_UPGRADE" apk --cache-dir "$APK_CACHE_DIR" upgrade --no-interactive --no-cache-packages)"
		_note="正在升级全部软件包"
	fi
	[ -n "$_id" ] || fail "500 Internal Server Error" '{"error":"无法启动任务"}'
	ok "{\"ok\":true,\"job_id\":\"$_id\",\"status\":\"running\",\"output\":\"$_note\",\"packages\":[]}"
}

# --------------------------------------------------------------- dispatch ---

case "$action" in
	list) action_installed "" ;;
	available) action_available "$keyword" ;;
	stats) action_stats ;;
	search)
		case "$scope" in
			available) action_available "$keyword" ;;
			*) action_installed "$keyword" ;;
		esac
		;;
	install) action_install ;;
	remove) action_remove ;;
	update) action_update ;;
	upgrade) action_upgrade ;;
	status) action_status ;;
	*) fail "400 Bad Request" '{"error":"不支持的操作","code":"unsupported_action"}' ;;
esac
