#!/bin/sh
# POST /cgi-bin/modern-exec?sid=<session>
# Body: { "tool": "ping" | "dns" | "trace" | "routes" | "ports", "target": "example.com",
#         "count": "5", "size": "56", "wait": "3",
#         "hops": "15", "twait": "1", "probes": "3" }
#
# Runs one of five fixed, read-only diagnostics. The tool name only selects a
# command from the allowlist below, so a caller can never name a program or
# pass a flag. The target is the single user supplied value: it is validated
# against a strict character set and then handed to the command as one quoted
# argument, so the shell never re-parses it.
#
# The presets of the network tools (ping count, packet size, wait time,
# traceroute hops, wait time, probes) are numbers only. They are clamped to a
# sane range and a value outside the range falls back to the default, so a
# caller can never turn them into an option. They are part of the command
# line, so the answer carries the command that really ran and the effective
# values of the parameters.
#
# Response body:
#   { "tool", "target", "command", "params", "output", "exit_code",
#     "duration_ms", "truncated" }

MAX_BODY=4096
MAX_OUTPUT=204800

# Watchdog per tool (seconds). The router has no `timeout` command, so every
# command runs in the background and a watchdog kills it when it overruns.
# A traceroute with 20 hops, 3 probes and 2 seconds per probe needs the
# largest budget of them.
T_PING=30
T_DNS=15
T_TRACE=120
T_LOCAL=10

# The defaults of the presets. They are the same on the console side.
D_COUNT=5
D_SIZE=56
D_WAIT=3
D_HOPS=15
D_TWAIT=1
D_PROBES=3

# Sends the body of a reply. The body is validated before it leaves the
# router: a malformed answer only shows up in the browser as "cannot parse"
# and hides the real cause, so a body that does not survive jsonfilter is
# replaced by a readable error.
send_json() {
	__sj_body="$1"
	__sj_out="/tmp/.modern-resp.$$"
	printf '%s' "$__sj_body" > "$__sj_out" 2>/dev/null
	if command -v jsonfilter >/dev/null 2>&1; then
		if ! jsonfilter -i "$__sj_out" -e '@' >/dev/null 2>&1; then
			printf '%s' '{"ok":false,"error":"路由器生成了无效的响应，请查看系统日志"}' > "$__sj_out"
		fi
	fi
	cat "$__sj_out"
	rm -f "$__sj_out" 2>/dev/null
}

deny() {
	printf 'Status: 401 Unauthorized\r\n'
	printf 'Content-Type: application/json; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n\r\n'
	printf '{"error":"unauthorized"}'
	exit 0
}

fail() {
	printf 'Status: %s\r\n' "$1"
	printf 'Content-Type: application/json; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n\r\n'
	send_json "$2"
	exit 0
}

# ---------------------------------------------------------------- session ---
# The sid may arrive in the owrt_sid cookie or as ?sid=; both are validated
# against rpcd before anything is executed.

qs="${QUERY_STRING:-}"
sid=""
oldIFS=$IFS
IFS='&'
for pair in $qs; do
	key="${pair%%=*}"
	val="${pair#*=}"
	case "$key" in
		sid) sid="$val" ;;
	esac
done
IFS=$oldIFS

if [ -z "$sid" ]; then
	sid="$(printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed -n 's/^ *owrt_sid=//p' | head -n 1)"
fi
[ -n "$sid" ] || deny

# Only characters that are inert inside the ubus JSON payload are accepted,
# so a session id can never break out of the string it is placed in.
case "$sid" in
	*[!A-Za-z0-9._~+/=-]*) deny ;;
esac

ubus call session get "{\"ubus_rpc_session\":\"$sid\"}" 2>/dev/null | grep -q '"username"' || deny

# ------------------------------------------------------------------ body ---
[ "${REQUEST_METHOD:-GET}" = "POST" ] ||
	fail "405 Method Not Allowed" '{"error":"只接受 POST 请求"}'

body="$(head -c $((MAX_BODY + 1)) 2>/dev/null)"
[ -n "$body" ] || fail "400 Bad Request" '{"error":"请求体为空"}'
[ "${#body}" -le "$MAX_BODY" ] || fail "413 Payload Too Large" '{"error":"请求体过大"}'

# One flat line keeps the key/value extraction below predictable.
body="$(printf '%s' "$body" | tr '\012\015\011' '   ')"

json_string() {
	# $1 = key name. Prints the value of the first "key":"value" pair found.
	# The value can never contain a quote, so it stays a single token.
	printf '%s' "$body" |
		grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" |
		head -n 1 |
		sed 's/^"[^"]*"[[:space:]]*:[[:space:]]*"\(.*\)"$/\1/'
}

tool="$(json_string tool)"
target="$(json_string target)"
raw_count="$(json_string count)"
raw_size="$(json_string size)"
raw_wait="$(json_string wait)"
raw_hops="$(json_string hops)"
raw_twait="$(json_string twait)"
raw_probes="$(json_string probes)"

case "$tool" in
	ping|dns|trace|routes|ports) ;;
	*) fail "400 Bad Request" '{"error":"不支持的诊断工具"}' ;;
esac

case "$tool" in
	routes|ports) target="" ;;
esac

if [ "$tool" != "routes" ] && [ "$tool" != "ports" ]; then
	[ -n "$target" ] || fail "400 Bad Request" '{"error":"请填写诊断目标"}'
	# ^[A-Za-z0-9._:-]{1,253}$ - no whitespace, quotes or shell metacharacters.
	case "$target" in
		*[!A-Za-z0-9._:-]*) fail "400 Bad Request" '{"error":"目标地址包含非法字符"}' ;;
	esac
	[ "${#target}" -le 253 ] || fail "400 Bad Request" '{"error":"目标地址过长"}'
	# A leading dash would be read as an option by the diagnostics.
	case "$target" in
		-*) fail "400 Bad Request" '{"error":"目标地址不能以 - 开头"}' ;;
	esac
fi

# --------------------------------------------------------------- presets ---
# Prints the parameter when it is a plain number inside the range, otherwise
# the default. $1 = value, $2 = min, $3 = max, $4 = default.
num_param() {
	case "$1" in
		''|*[!0-9]*) printf '%s' "$4"; return ;;
	esac
	if [ "$1" -lt "$2" ] || [ "$1" -gt "$3" ]; then
		printf '%s' "$4"
		return
	fi
	printf '%s' "$1"
}

p_count="$(num_param "$raw_count" 1 20 "$D_COUNT")"
p_size="$(num_param "$raw_size" 56 1400 "$D_SIZE")"
p_wait="$(num_param "$raw_wait" 1 10 "$D_WAIT")"
p_hops="$(num_param "$raw_hops" 1 30 "$D_HOPS")"
p_twait="$(num_param "$raw_twait" 1 5 "$D_TWAIT")"
p_probes="$(num_param "$raw_probes" 1 3 "$D_PROBES")"

# -------------------------------------------------------------- execution ---
out_file="/tmp/modern-exec.$$"
: > "$out_file" 2>/dev/null || fail "500 Internal Server Error" '{"error":"无法写入临时文件"}'
trap 'rm -f "$out_file" "$out_file.cut"' EXIT INT TERM

start_ts="$(date +%s 2>/dev/null)"
case "$start_ts" in
	''|*[!0-9]*) start_ts="" ;;
esac

# This router has no coreutils timeout, so the command runs in the background
# and a watchdog kills it when it overruns the budget of the tool.
#   $1 = timeout seconds, rest = command
run_tool() {
	_rt="$1"
	shift
	"$@" > "$out_file" 2>&1 &
	_rt_pid=$!
	(
		_i=0
		while [ "$_i" -lt "$_rt" ]; do
			sleep 1
			_i=$((_i + 1))
		done
		kill -9 "$_rt_pid" 2>/dev/null
	) &
	_rt_guard=$!
	wait "$_rt_pid" 2>/dev/null
	_rt_status=$?
	kill "$_rt_guard" 2>/dev/null
	wait "$_rt_guard" 2>/dev/null
	return $_rt_status
}

params_json="{}"
case "$tool" in
	ping)
		command="ping -c $p_count -s $p_size -W $p_wait $target"
		params_json="{\"count\":$p_count,\"size\":$p_size,\"wait\":$p_wait}"
		run_tool "$T_PING" ping -c "$p_count" -s "$p_size" -W "$p_wait" "$target"
		;;
	dns)
		command="nslookup $target"
		run_tool "$T_DNS" nslookup "$target"
		;;
	trace)
		command="traceroute -n -w $p_twait -q $p_probes -m $p_hops $target"
		params_json="{\"hops\":$p_hops,\"twait\":$p_twait,\"probes\":$p_probes}"
		run_tool "$T_TRACE" traceroute -n -w "$p_twait" -q "$p_probes" -m "$p_hops" "$target"
		;;
	routes)
		command="ip route show"
		run_tool "$T_LOCAL" ip route show
		;;
	ports)
		command="netstat -lntup"
		run_tool "$T_LOCAL" netstat -lntup
		;;
esac
status=$?

end_ts="$(date +%s 2>/dev/null)"
case "$end_ts" in
	''|*[!0-9]*) end_ts="" ;;
esac

duration_ms=0
if [ -n "$start_ts" ] && [ -n "$end_ts" ]; then
	duration_ms=$(( (end_ts - start_ts) * 1000 ))
	[ "$duration_ms" -ge 0 ] || duration_ms=0
	[ "$duration_ms" -le 600000 ] || duration_ms=0
fi

# ------------------------------------------------------------- truncation ---
truncated=false
size="$(wc -c < "$out_file" 2>/dev/null)"
case "$size" in
	''|*[!0-9]*) size=0 ;;
esac

if [ "$size" -gt "$MAX_OUTPUT" ]; then
	head -c "$MAX_OUTPUT" "$out_file" > "$out_file.cut" 2>/dev/null
	{
		cat "$out_file.cut"
		printf '\n\n[输出超过 %s 字节，已截断]\n' "$MAX_OUTPUT"
	} > "$out_file" 2>/dev/null
	truncated=true
fi

# ----------------------------------------------------------------- output ---
# The command output is embedded as a JSON string, so quotes, backslashes and
# control characters have to be escaped. Everything is rendered as plain text.
json="$(awk -v code="$status" -v tool="$tool" -v target="$target" \
	-v command="$command" -v dur="$duration_ms" -v trunc="$truncated" \
	-v params="$params_json" '
BEGIN {
	BS = sprintf("%c", 92)
	Q = sprintf("%c", 34)
	nl = BS "n"
	printf "{\"tool\":\"%s\",\"target\":\"%s\",\"command\":\"%s\",\"params\":%s,\"exit_code\":%d,\"duration_ms\":%d,\"truncated\":%s,\"output\":\"",
		tool, target, command, params, code, dur, (trunc == "true" ? "true" : "false")
}
function esc(s) {
	gsub(/\\/, BS BS BS BS, s)
	gsub(/"/, BS BS Q, s)
	gsub(/\t/, BS BS "t", s)
	gsub(/\r/, BS BS "r", s)
	gsub(/[\001-\037]/, " ", s)
	return s
}
{
	if (NR > 1) printf "%s", nl
	printf "%s", esc($0)
}
END {
	printf "\"}"
}
' "$out_file" 2>/dev/null)"

[ -n "$json" ] || fail "500 Internal Server Error" '{"error":"生成结果失败"}'

printf 'Status: 200 OK\r\n'
printf 'Content-Type: application/json; charset=utf-8\r\n'
printf 'Cache-Control: no-store\r\n'
printf 'X-Content-Type-Options: nosniff\r\n\r\n'
send_json "$json"
